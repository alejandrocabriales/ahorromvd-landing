---
import "../styles/global.css";

const {
  title = "AhorroMVD | Tu copiloto de ahorro para Montevideo",
  description = "Buscá descuentos, promociones y conveniencias en Montevideo por WhatsApp, sin descargar una app.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
